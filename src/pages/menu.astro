    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/styles.css">
    <style>
        /* Advanced styling for the custom Menu page */
        .menu-hero {
            position: relative;
            background: linear-gradient(135deg, rgba(255, 107, 53, 0.15) 0%, rgba(247, 147, 30, 0.15) 100%);
            padding: 7rem 2rem 5rem 2rem;
            text-align: center;
            border-radius: var(--border-radius);
            margin-bottom: 3rem;
            border: 1px solid rgba(255, 107, 53, 0.1);
        }

        .menu-hero h2 {
            font-size: 3.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--dark-color) 30%, var(--primary-color) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
        }

        .menu-hero p {
            font-size: 1.3rem;
            color: #555;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Scrolling Category Filter Bar */
        .category-filters-container {
            position: sticky;
            top: 90px; /* offset for header sticky */
            z-index: 999;
            background: rgba(250, 247, 242, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 1rem 0;
            margin-bottom: 3rem;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .category-filters {
            display: flex;
            justify-content: flex-start;
            gap: 1rem;
            overflow-x: auto;
            padding: 0.5rem 1rem;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none;  /* IE and Edge */
            max-width: 1400px;
            margin: 0 auto;
        }

        .category-filters::-webkit-scrollbar {
            display: none; /* Chrome, Safari, Opera */
        }

        .filter-btn {
            background: var(--white);
            color: var(--dark-color);
            border: 2px solid rgba(0,0,0,0.05);
            padding: 0.8rem 1.8rem;
            border-radius: 30px;
            font-family: inherit;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            white-space: nowrap;
            transition: var(--transition);
            box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        }

        .filter-btn:hover {
            color: var(--primary-color);
            border-color: var(--primary-color);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(255,107,53,0.1);
        }

        .filter-btn.active {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: var(--white);
            border-color: transparent;
            box-shadow: 0 6px 20px rgba(255, 107, 53, 0.35);
        }

        /* Items container modification */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
            gap: 2.5rem;
            min-height: 400px;
            transition: opacity 0.3s ease;
        }

        .menu-item {
            display: block;
            opacity: 1;
            transform: scale(1);
            transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Active Nav Link */
        nav a.active {
            background: rgba(255, 255, 255, 0.2);
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        /* responsive filter top */
        @media (max-width: 768px) {
            .category-filters-container {
                top: 0;
                padding: 0.6rem 0;
            }

            .menu-grid {
                grid-template-columns: minmax(0, 1fr);
                gap: 1.25rem;
                min-height: 0;
            }

            .filter-btn {
                padding: 0.6rem 1.4rem;
                font-size: 0.85rem;
            }
        }

        .menu-hero {
            background: #EFE9DE;
            border: 0;
        }

        .menu-hero h2 {
            background: none;
            color: var(--dark-color);
            -webkit-text-fill-color: currentColor;
        }

        .category-filters-container {
            background: var(--light-color);
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
        }

        .filter-btn {
            border-width: 1px;
            border-radius: 8px;
        }

        .filter-btn.active {
            background: var(--primary-color);
            box-shadow: none;
        }
    </style>
</head>
